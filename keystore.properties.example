# Copy this file to keystore.properties (gitignored) for local signed release builds.
#
# Preferred: generate the keystore off-tree and push the four GitHub Actions secrets:
#   .github/scripts/create-release-keystore.sh
# That writes ~/.xr-launcher-keys/ (keep a backup) and sets SIGNING_KEY,
# SIGNING_STORE_PASSWORD, SIGNING_KEY_ALIAS, SIGNING_KEY_PASSWORD on
# electrikjesus/XR-Launcher.
#
# Manual local keystore (only if you are not using the script):
#   mkdir -p keystore
#   keytool -genkeypair -v \
#     -keystore keystore/xr-launcher-release.jks \
#     -alias xr-launcher \
#     -keyalg RSA -keysize 4096 -validity 10950 \
#     -storetype PKCS12
#
# GitHub Actions secrets (Repository settings -> Secrets and variables -> Actions):
#   SIGNING_KEY            = single-line base64 of the keystore file
#   SIGNING_STORE_PASSWORD = keystore password
#   SIGNING_KEY_ALIAS      = xr-launcher
#   SIGNING_KEY_PASSWORD   = key password

storeFile=keystore/xr-launcher-release.jks
storePassword=CHANGE_ME
keyAlias=xr-launcher
keyPassword=CHANGE_ME
